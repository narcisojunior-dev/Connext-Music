{
  "expo": {
    "name": "Connext Music",
    "slug": "Connext-Music",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "connextmusic",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.narcisojunior.connextmusic",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSDocumentsFolderUsageDescription": "O Connext Music precisa acessar a pasta Documentos para encontrar e reproduzir os arquivos de música que você adicionou ao app."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.narcisojunior.connextmusic"
        ]
      },
      "buildNumber": "1",
      "requireFullScreen": false
    },
    "android": {
      "package": "com.narcisojunior.connextmusic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/with-siri-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Player de música local para iPhone. Sem streaming, sem conta, sem internet.",
    "primaryColor": "#3B82F6"
  }
}
